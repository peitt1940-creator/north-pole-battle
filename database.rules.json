{
  "rules": {
    ".read": false,
    ".write": false,
    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "game": {
      ".read": "auth != null && root.child('teachers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teachers').child(auth.uid).val() === true",
      "public": {
        ".read": "auth != null && (auth != null && root.child('teachers').child(auth.uid).val() === true || root.child('pairing/members').child(auth.uid).child('team').exists())"
      },
      "submissions": {
        "$team": {
          ".read": "auth != null && root.child('pairing/members').child(auth.uid).child('team').val() === $team",
          ".write": "auth != null && root.child('pairing/members').child(auth.uid).child('team').val() === $team && ($team === 'red' || $team === 'green' || $team === 'gold') && root.child('game/public/phase').val() === 'open' && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['round','session','moves']) && newData.child('round').val() === root.child('game/public/round').val() && newData.child('session').val() === root.child('game/public/session').val()",
          "round": {
            ".validate": "newData.isNumber()"
          },
          "session": {
            ".validate": "newData.isString()"
          },
          "moves": {
            "0": {
              ".validate": "newData.hasChildren(['cell','type']) && ((newData.child('type').val() === 'claim' && root.child('game/public/board').child(newData.child('cell').val() + '').val() === 'empty') || (newData.child('type').val() === 'defend' && root.child('game/public/board').child(newData.child('cell').val() + '').val() === $team) || (newData.child('type').val() === 'attack' && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== 'empty' && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== $team && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== null))",
              "cell": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
              },
              "type": {
                ".validate": "newData.val() === 'claim' || newData.val() === 'attack' || newData.val() === 'defend'"
              },
              "$other": {
                ".validate": false
              }
            },
            "1": {
              ".validate": "newData.hasChildren(['cell','type']) && ((newData.child('type').val() === 'claim' && root.child('game/public/board').child(newData.child('cell').val() + '').val() === 'empty') || (newData.child('type').val() === 'defend' && root.child('game/public/board').child(newData.child('cell').val() + '').val() === $team) || (newData.child('type').val() === 'attack' && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== 'empty' && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== $team && root.child('game/public/board').child(newData.child('cell').val() + '').val() !== null))",
              "cell": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0"
              },
              "type": {
                ".validate": "newData.val() === 'claim' || newData.val() === 'attack' || newData.val() === 'defend'"
              },
              "$other": {
                ".validate": false
              }
            },
            ".validate": "newData.hasChildren(['0','1']) && newData.child('0/cell').val() !== newData.child('1/cell').val()",
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "missions": {
        "$team": {
          ".read": "auth != null && root.child('pairing/members').child(auth.uid).child('team').val() === $team"
        }
      }
    },
    "pairing": {
      ".read": "auth != null && root.child('teachers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('teachers').child(auth.uid).val() === true",
      "invites": {
        "$code": {
          ".read": "auth != null && data.exists() && (!data.child('uid').exists() || data.child('uid').val() === auth.uid)",
          ".write": "auth != null && data.exists() && newData.exists() && (!data.child('uid').exists() || data.child('uid').val() === auth.uid) && newData.child('team').val() === data.child('team').val() && newData.child('uid').val() === auth.uid && root.child('pairing/codes').child(newData.child('team').val()).val() === $code && newData.parent().parent().child('members').child(auth.uid).child('team').val() === newData.child('team').val() && newData.parent().parent().child('members').child(auth.uid).child('code').val() === $code",
          ".validate": "newData.hasChildren(['team'])",
          "team": {
            ".validate": "(newData.val() === 'red' || newData.val() === 'green' || newData.val() === 'gold')"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "members": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.child('code').isString() && (!data.exists() || (data.child('code').val() === newData.child('code').val() && data.child('team').val() === newData.child('team').val())) && root.child('pairing/codes').child(newData.child('team').val()).val() === newData.child('code').val() && newData.parent().parent().child('invites').child(newData.child('code').val()).child('team').val() === newData.child('team').val() && newData.parent().parent().child('invites').child(newData.child('code').val()).child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['team','code'])",
          "team": {
            ".validate": "(newData.val() === 'red' || newData.val() === 'green' || newData.val() === 'gold')"
          },
          "code": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
